FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg tini \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/publish-samples.sh /app/publish-samples.sh
COPY dev/media/camera*.mp4 /media/

RUN chmod 755 /app/publish-samples.sh

USER nobody:nogroup

ENTRYPOINT ["tini", "-g", "--", "/app/publish-samples.sh"]